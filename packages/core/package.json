{
  "name": "@untracenetwork/sdk",
  "version": "2.0.0",
  "description": "Untrace Drive SDK: OAuth client credentials, files encrypted on your machine (AES-256-GCM), typed from the Drive OpenAPI contract.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/untracenetwork/untrace-sdk.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./backend": {
      "import": {
        "types": "./dist/backend.d.ts",
        "default": "./dist/backend.js"
      },
      "require": {
        "types": "./dist/backend.d.cts",
        "default": "./dist/backend.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7"
  },
  "homepage": "https://github.com/untracenetwork/untrace-sdk#readme",
  "bugs": {
    "url": "https://github.com/untracenetwork/untrace-sdk/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "untrace",
    "untrace-drive",
    "encrypted-storage",
    "end-to-end-encryption",
    "sdk"
  ]
}
